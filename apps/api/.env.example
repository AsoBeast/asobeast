NODE_ENV=development         # development, test or production. The Docker image sets production, which turns on the configuration guards
DATABASE_URL=postgresql://asobeast:asobeast@localhost:5433/asobeast
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
PORT=4000
DEFAULT_COUNTRY=us
CRON_DAILY=0 3 * * *        # daily pipeline start, UTC; batched alerts send after processing completes
CRON_SCORING=0 4 * * 0      # weekly scoring, UTC (Sunday)
SCRAPE_ITUNES_RPM=15
SCRAPE_GPLAY_RPM=10           # google play job-starts/minute; depth-200 ranks use ~8 requests, halve if BlockedError appears
ALERT_RANK_DROP_THRESHOLD=5   # positions a primary app must fall/rise to alert
ALERT_REVIEW_SCORE_MAX=2      # reviews at or below this star rating fire review.negative (1-4)
ALERT_DELIVERY=batched       # batched: up to two scoped reports/channel after daily completion; instant: per-event delivery. WARNS in production when instant has no SMTP configured; webhook subscriptions live in the database and cannot be checked here
WEBHOOK_ALLOW_PRIVATE_TARGETS=false # false keeps alert webhooks on public addresses, refusing loopback, private, link-local and cloud metadata targets at both registration and connection time. true opts a self-hosted instance in to LAN delivery. REFUSES TO BOOT when true and BILLING_ENABLED=true, because a webhook url is chosen by the customer; WARNS in production otherwise
RETENTION_RANKINGS_DAYS=365       # prune keyword rankings older than N days; 0 keeps forever
RETENTION_SERP_DAYS=90            # prune serp entries older than N days; 0 keeps forever
RETENTION_SNAPSHOTS_DAYS=180      # prune app snapshots older than N days; newest per app always kept; 0 keeps forever
RETENTION_CATEGORY_RANKS_DAYS=365 # prune category ranks older than N days; 0 keeps forever
RETENTION_CHANGE_EVENTS_DAYS=0    # prune change events older than N days; 0 keeps forever
RETENTION_DELIVERIES_DAYS=30      # prune alert delivery log rows older than N days; 0 keeps forever
RETENTION_AUDIT_SCORES_DAYS=0     # prune audit score rows older than N days; 0 keeps forever
RETENTION_BILLING_EVENTS_DAYS=90    # stored stripe webhook payloads; they carry customer billing details. 0 keeps forever
RETENTION_ACTIONS_DAYS=180        # prune closed action items older than N days; open/snoozed are never pruned; 0 keeps forever

# Egress proxy pool (optional) — leave PROXY_PROVIDER=none to keep every store request on the host address
PROXY_PROVIDER=none               # none disables the pool entirely; webshare syncs the account's proxy list
PROXY_API_URL=https://proxy.webshare.io/api/v2  # provider api base url
PROXY_API_KEY=                    # provider api key. REFUSES TO BOOT when PROXY_PROVIDER is not none and this is empty
PROXY_USERNAME=                   # credentials shared across the pool; leave empty for an ip-authorized account
PROXY_PASSWORD=
PROXY_ENDPOINT_RPM=15             # requests per minute per pool endpoint. Replaces the single host budget once the pool is on
PROXY_ACQUIRE_TIMEOUT_MS=120000   # how long a job waits for a free endpoint before it fails and the queue retries it; a shutdown ends the wait at once so it never holds up a drain
PROXY_WORKER_MAX_CONCURRENCY=8    # ceiling for store worker concurrency once the pool is on; actual concurrency tracks the healthy endpoint count. Ignored while PROXY_PROVIDER=none
CRON_PROXY_SYNC=0 2 * * *         # pool reconciliation against the provider, UTC. Never scheduled while PROXY_PROVIDER=none
CRON_STORE_CANARY=0 2,8,14,20 * * * # parser canary, UTC, one hour before the daily run. Empty removes the schedule and switches the canary off
STORE_STATUS_URL=                 # optional, opt-in outbound. Url of a published store status document. Empty means no request is ever made
CRON_STORE_STATUS=17 * * * *      # published status poll, UTC. Never scheduled while STORE_STATUS_URL is empty
PROXY_RESIDENTIAL_URL=            # emergency gateway used only after a datacenter endpoint is blocked. Empty disables the fallback
PROXY_RESIDENTIAL_USERNAME=
PROXY_RESIDENTIAL_PASSWORD=
PROXY_RESIDENTIAL_MONTHLY_CAP_USD=0   # hard monthly ceiling. 0 refuses every fallback, so an unbounded block cannot become an unbounded bill
PROXY_RESIDENTIAL_COST_PER_GB=3       # provider list price, used to price the cap
PROXY_RESIDENTIAL_MB_PER_REQUEST=1.2  # measured average response size; the two together estimate month to date spend
SIGNUP_CAPACITY_MAX_UTILIZATION=0     # 0 disables the gate. Above 0, registration is refused once tracked collection passes this share of daily capacity. Only applied when BILLING_ENABLED=true

# ASO Action Center
ACTIONS_MAX_OPEN_PER_APP=20       # how many new actions one run may open per app, highest impact first
ACTIONS_SNOOZE_MAX_DAYS=90        # furthest a snooze may be set into the future
ALERT_ACTIONS_MIN_PRIORITY=high   # lowest priority that fires an action.opened alert: critical|high|medium|low
WEB_PUBLIC_URL=                   # public web origin, http or https only, e.g. https://aso.example.com; any other scheme refuses to boot; builds deep links in alerts, the stripe return url and the confirmation and recovery links; account recovery is refused with 503 while it is empty, and is the only origin CORS allows. Empty sends no CORS headers at all, which is correct for the shipped topology because the browser only talks to the web origin. REFUSES TO BOOT when empty with BILLING_ENABLED=true and SMTP configured, because confirmation is then mandatory and its link would have no host. Checkout stays closed while it is empty
RETENTION_ALERT_EVENTS_DAYS=30    # prune completed alert claims older than N days; unfinished claims are retained; 0 keeps forever
CRON_RETENTION=0 5 * * *          # data retention pruning, UTC
CRON_DIGEST=0 8 * * 1             # weekly digest webhook, UTC (Monday 08:00)
CRON_AUDIT=0 6 * * *              # daily audit score snapshot, UTC (after the daily pipeline)
# SMTP for email alerts — leave SMTP_HOST/SMTP_FROM empty to disable email alerts
SMTP_HOST=                        # e.g. smtp.example.com or localhost for a relay
SMTP_PORT=587                     # 465 with SMTP_SECURE=true, otherwise 587/25
SMTP_SECURE=false                 # true wraps the connection in TLS (port 465). WARNS in production when true on any other port
SMTP_USER=                        # optional; leave empty for unauthenticated relays
SMTP_PASSWORD=                    # optional
SMTP_FROM=                        # e.g. asobeast <alerts@example.com>
# AI features (optional) — leave OPENAI_API_KEY empty to disable the AI audit and metadata drafts
OPENAI_API_KEY=                   # your OpenAI API key; enables Run AI audit + Generate drafts
AI_MODEL=gpt-4o                   # any current OpenAI model with vision + structured outputs
BULL_BOARD_ENABLED=true           # queue dashboard at /admin/queues; owner-only, reachable through the web app
API_DOCS=owner                    # owner: /docs needs a platform operator session; public: open to anyone; off: not served. WARNS in production when public
METRICS_CACHE_SECONDS=30          # how long a /metrics scrape is reused before the collectors run again; 0 collects on every scrape
BACKUP_MAX_AGE_HOURS=0            # hours a backup may go without reporting in before backup.stale fires; 0 expects no backup and never alerts
DISK_BUDGET_BYTES=0               # bytes the database may grow to before storage.headroom.low fires; 0 declares no budget and never alerts
# Authentication (required)
AUTH_SECRET=                      # required; >=32 chars, generate with: openssl rand -hex 32
AUTH_SESSION_DAYS=7               # session cookie lifetime in days
AUTH_ALLOW_REGISTRATION=false     # true keeps signups open; false closes registration once the first (owner) account exists (self-hosted). The first account always bootstraps as owner
AUTH_REGISTRATION_WORKSPACE=own   # where a self registration lands. own gives every sign up its own workspace, so a stranger never sees the data already tracked here. shared puts them all in the bootstrap workspace as members, for an instance whose sign ups are already trusted with that data; invite teammates from settings instead. REFUSES TO BOOT when shared and BILLING_ENABLED=true. WARNS in production when shared and AUTH_ALLOW_REGISTRATION=true
AUTH_COOKIE_SECURE=false          # REFUSES TO BOOT when false and NODE_ENV=production. The Docker image sets NODE_ENV=production
STRIPE_SECRET_KEY=                   # optional; billing is inert without it. Never logged
STRIPE_WEBHOOK_SECRET=              # required to accept /billing/webhook; an unverified endpoint grants subscriptions to anyone
STRIPE_PORTAL_RETURN_URL=           # where the customer portal returns to; defaults to WEB_PUBLIC_URL/settings
STRIPE_PRICE_INDIE_MONTHLY=         # price ids differ per environment; create them with pnpm --filter api stripe:catalog
STRIPE_PRICE_INDIE_YEARLY=
STRIPE_PRICE_ULTIMATE_MONTHLY=
STRIPE_PRICE_ULTIMATE_YEARLY=
CRON_BILLING_RECONCILE=0 7 * * *    # daily reconciliation against Stripe, UTC
CRON_TRIAL_NOTICES=0 9 * * *      # trial milestone emails, UTC
BILLING_ENABLED=false             # true starts every new account on a trial and gates access afterwards
TRIAL_DAYS=7                      # trial length in days when BILLING_ENABLED=true. REFUSES TO BOOT at 0 with billing enabled, which would lock out every new account
TRUST_PROXY=0                     # number of proxies you control between the internet and the API, counting the web app as one; true means 1 and false means 0. Lets auth rate-limits key on the real client IP. WARNS in production when 0
ACCOUNT_DELETION_GRACE_DAYS=7        # days a scheduled workspace deletion stays reversible before the retention job erases it
ERROR_TRACKING_DSN=              # optional, hosted only. Sentry dsn for scrubbed error reports. Ignored unless NODE_ENV=production and BILLING_ENABLED=true, so a self hosted deployment never reports errors outside itself
LOG_LEVEL=debug
