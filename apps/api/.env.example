NODE_ENV=development         # development, test or production. The Docker image sets production, which turns on the configuration guards
DATABASE_URL=postgresql://asobeast:asobeast@localhost:5433/asobeast
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
PORT=4000
DEFAULT_COUNTRY=us
CRON_DAILY=0 3 * * *        # daily pipeline start, UTC; batched alerts send after processing completes. Every CRON_ value REFUSES TO BOOT when it is not a cron pattern, except an empty CRON_STORE_CANARY, CRON_STORE_STATUS or CRON_LOCALIZATION_SWEEP, which removes that schedule
CRON_SCORING=0 4 * * 0      # weekly scoring, UTC (Sunday)
SCRAPE_ITUNES_RPM=15
SCRAPE_GPLAY_RPM=10           # google play job-starts/minute; depth-200 ranks use ~8 requests, halve if BlockedError appears
ALERT_RANK_DROP_THRESHOLD=5   # positions a primary app must fall/rise to alert
ALERT_REVIEW_SCORE_MAX=2      # reviews at or below this star rating fire review.negative (1-4)
ALERT_DELIVERY=batched       # batched: up to two scoped reports/channel after daily completion; instant: per-event delivery. WARNS in production when instant has no SMTP configured; webhook subscriptions live in the database and cannot be checked here
WEBHOOK_ALLOW_PRIVATE_TARGETS=false # false keeps alert webhooks on public addresses, refusing loopback, private, link-local and cloud metadata targets at both registration and connection time. true opts a self-hosted instance in to LAN delivery. REFUSES TO BOOT when true and BILLING_ENABLED=true, because a webhook url is chosen by the customer; WARNS in production otherwise
RETENTION_RANKINGS_DAYS=365       # prune keyword rankings older than N days; 0 keeps forever
RETENTION_SERP_DAYS=90            # prune serp entries older than N days; 0 keeps forever
RETENTION_SNAPSHOTS_DAYS=180      # prune app snapshots older than N days; newest per app and market always kept; 0 keeps forever
RETENTION_CATEGORY_RANKS_DAYS=365 # prune category ranks older than N days; 0 keeps forever
RETENTION_CHARTS_DAYS=365 # prune top chart captures older than N days; 0 keeps forever
RETENTION_CHANGE_EVENTS_DAYS=0    # prune change events older than N days; 0 keeps forever
RETENTION_DELIVERIES_DAYS=30      # prune alert delivery log rows older than N days; 0 keeps forever
RETENTION_AUDIT_SCORES_DAYS=0     # prune audit score rows older than N days; 0 keeps forever
RETENTION_BILLING_EVENTS_DAYS=90    # stored stripe webhook payloads; they carry customer billing details. 0 keeps forever
RETENTION_ACTIONS_DAYS=180        # prune closed action items older than N days; open/snoozed are never pruned; 0 keeps forever
RETENTION_AI_CALLS_DAYS=400       # ai call ledger rows; never prunes the current month, which the monthly allowance still counts; 0 keeps forever
RETENTION_STORE_REPORTS_DAYS=35      # downloaded app store connect report files kept for reprocessing; the funnel rows built from them are never pruned by age; 0 keeps forever

# Egress proxy pool (optional) — leave PROXY_PROVIDER=none to keep every store request on the host address
PROXY_PROVIDER=none               # none disables the pool entirely; webshare syncs the account's proxy list
PROXY_API_URL=https://proxy.webshare.io/api/v2  # provider api base url
# provider api key. REFUSES TO BOOT when PROXY_PROVIDER is not none and this is empty
PROXY_API_KEY=
# credentials shared across the pool; leave empty for an ip-authorized account
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_ENDPOINT_RPM=15             # requests per minute per pool endpoint. Replaces the single host budget once the pool is on
PROXY_ACQUIRE_TIMEOUT_MS=120000   # how long a job waits for a free endpoint before it fails and the queue retries it; a shutdown ends the wait at once so it never holds up a drain
PROXY_WORKER_MAX_CONCURRENCY=8    # ceiling for store worker concurrency once the pool is on; actual concurrency tracks the healthy endpoint count. Ignored while PROXY_PROVIDER=none
CRON_PROXY_SYNC=0 2 * * *         # pool reconciliation against the provider, UTC. Never scheduled while PROXY_PROVIDER=none
CRON_STORE_CANARY=0 2,8,14,20 * * * # parser canary, UTC, one hour before the daily run. Empty removes the schedule and switches the canary off
# optional, opt-in outbound. Url of a published store status document. Empty means no request is ever made
STORE_STATUS_URL=
CRON_STORE_STATUS=17 * * * *      # published status poll, UTC. Never scheduled while STORE_STATUS_URL is empty. Empty removes the schedule
# emergency gateway used only after a datacenter endpoint is blocked. Empty disables the fallback
PROXY_RESIDENTIAL_URL=
PROXY_RESIDENTIAL_USERNAME=
PROXY_RESIDENTIAL_PASSWORD=
PROXY_RESIDENTIAL_MONTHLY_CAP_USD=0   # hard monthly ceiling. 0 refuses every fallback, so an unbounded block cannot become an unbounded bill
PROXY_RESIDENTIAL_COST_PER_GB=3       # provider list price, used to price the cap
PROXY_RESIDENTIAL_MB_PER_REQUEST=1.2  # measured average response size; the two together estimate month to date spend
SIGNUP_CAPACITY_MAX_UTILIZATION=0     # 0 disables the gate. Above 0, registration is refused once tracked collection passes this share of daily capacity. Only applied when BILLING_ENABLED=true

# ASO Action Center
ACTIONS_MAX_OPEN_PER_APP=20       # how many new actions one run may open per app, highest impact first
ACTIONS_SNOOZE_MAX_DAYS=90        # furthest a snooze may be set into the future
ALERT_ACTIONS_MIN_PRIORITY=high   # lowest priority that fires an action.opened alert: critical|high|medium|low
# public web origin, http or https only, e.g. https://aso.example.com; any other scheme refuses to boot; builds every link in emails (confirmation, reset, invitation, deep links, logo, unsubscribe), deep links in alert payloads and the stripe return url; one click unsubscribe headers need it on https; account recovery is refused with 503 while it is empty, and is the only origin CORS allows. Empty sends no CORS headers at all, which is correct for the shipped topology because the browser only talks to the web origin. REFUSES TO BOOT when empty with BILLING_ENABLED=true and SMTP configured, because confirmation is then mandatory and its link would have no host. Checkout stays closed while it is empty. WARNS in production when empty with SMTP configured, because no email alert recipient can then be asked to confirm, and when it names this machine (localhost, 127.0.0.1 or [::1]) with SMTP configured, because no recipient elsewhere can open its links
WEB_PUBLIC_URL=
RETENTION_ALERT_EVENTS_DAYS=30    # prune completed alert claims older than N days; unfinished claims are retained; 0 keeps forever
CRON_RETENTION=0 5 * * *          # data retention pruning, UTC
CRON_DIGEST=0 8 * * 1             # weekly digest webhook, UTC (Monday 08:00)
CRON_AUDIT=0 6 * * *              # daily audit score snapshot, UTC (after the daily pipeline)
CRON_LOCALIZATION_SWEEP=0 7 * * 1 # weekly probe of the App Store localizations every app ships, UTC (Monday 07:00). Empty removes the schedule
# SMTP for email alerts — leave SMTP_HOST/SMTP_FROM empty to disable email alerts
# e.g. smtp.example.com or localhost for a relay
SMTP_HOST=
SMTP_PORT=587                     # 465 with SMTP_SECURE=true, otherwise 587/25
SMTP_SECURE=false                 # true wraps the connection in TLS (port 465). WARNS in production when true on any other port
# optional; leave empty for unauthenticated relays
SMTP_USER=
# optional
SMTP_PASSWORD=
# e.g. asobeast <alerts@example.com>
SMTP_FROM=
# optional. Sign every email with DKIM for this domain, the SMTP_FROM domain or its parent. The three SMTP_DKIM_ variables are all set or all unset. REFUSES TO BOOT when only some are set
SMTP_DKIM_DOMAIN=
# DKIM selector; publish the public key at <selector>._domainkey.<domain>
SMTP_DKIM_SELECTOR=
# PEM private key, e.g. keys/dkim-private.pem. Relative paths resolve against apps/api, which the Compose stacks mount read only at apps/api/keys. REFUSES TO BOOT when the three are set and the path is not a readable file. Its contents are never logged
SMTP_DKIM_PRIVATE_KEY_PATH=
# AI features (optional) — leave OPENAI_API_KEY empty to disable the AI audit and metadata drafts
# your OpenAI API key; enables Run AI audit + Generate drafts
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-luna             # any current OpenAI model with vision + structured outputs
# optional; AI calls each workspace may make per UTC month when BILLING_ENABLED=false. Empty = unlimited, 0 turns AI calls off. Ignored with billing on, where each plan sets its own allowance. WARNS in production when empty with OPENAI_API_KEY set and AUTH_ALLOW_REGISTRATION=true
AI_CALLS_PER_MONTH=
SCREENSHOT_OCR=true                 # read the caption text printed on app store screenshots on this machine; false records the screenshot list and detects image changes but downloads and reads no screenshots; a changed icon address still downloads two renditions for the pixel comparison
SCREENSHOT_OCR_LANGUAGES=eng,deu,fra,spa,por,ita,jpn,kor,chi_sim,chi_tra,rus,ara,tha,pol  # bundled language packs the reader may use; a storefront reads English plus its own language; REFUSES TO BOOT on a name that is not bundled
BULL_BOARD_ENABLED=true           # queue dashboard at /admin/queues; owner-only, reachable through the web app
API_DOCS=owner                    # owner: /docs needs a platform operator session; public: open to anyone; off: not served. WARNS in production when public
METRICS_CACHE_SECONDS=30          # how long a /metrics scrape is reused before the collectors run again; 0 collects on every scrape
BACKUP_MAX_AGE_HOURS=0            # hours a backup may go without reporting in before backup.stale fires; 0 expects no backup and never alerts
DISK_BUDGET_BYTES=0               # bytes the database may grow to before storage.headroom.low fires; 0 declares no budget and never alerts
# Authentication (required)
# required; >=32 chars, generate with: openssl rand -hex 32
AUTH_SECRET=
AUTH_SESSION_DAYS=7               # session cookie lifetime in days
AUTH_ALLOW_REGISTRATION=false     # true keeps signups open; false closes registration once the first (owner) account exists (self-hosted). The first account always bootstraps as owner
AUTH_REGISTRATION_WORKSPACE=own   # where a self registration lands. own gives every sign up its own workspace, so a stranger never sees the data already tracked here. shared puts them all in the bootstrap workspace as members, for an instance whose sign ups are already trusted with that data; invite teammates from settings instead. REFUSES TO BOOT when shared and BILLING_ENABLED=true. WARNS in production when shared and AUTH_ALLOW_REGISTRATION=true
AUTH_COOKIE_SECURE=false          # REFUSES TO BOOT when false and NODE_ENV=production. The Docker image sets NODE_ENV=production
# optional; billing is inert without it. Never logged. One sandbox per environment; a sandbox shared with another stack posts that stack's events here. WARNS in production when BILLING_ENABLED=true on a sandbox key
STRIPE_SECRET_KEY=
# required to accept /billing/webhook; an unverified endpoint grants subscriptions to anyone
STRIPE_WEBHOOK_SECRET=
# where the customer portal returns to; defaults to WEB_PUBLIC_URL/settings
STRIPE_PORTAL_RETURN_URL=
STRIPE_TAX_ENABLED=false            # true adds automatic tax to every checkout. Needs Stripe Tax active with registrations and prices that carry a tax behaviour, or checkout refuses to open. REFUSES TO BOOT together with STRIPE_MANAGED_PAYMENTS=true
STRIPE_MANAGED_PAYMENTS=false       # true sells every checkout through Stripe Managed Payments, Stripe's merchant of record: Stripe calculates, collects and remits the tax. Needs Managed Payments activated in the dashboard. REFUSES TO BOOT when true and STRIPE_TAX_ENABLED=true. WARNS in production when BILLING_ENABLED=true on a live key with neither this nor STRIPE_TAX_ENABLED
# optional; empty resolves the price by its lookup key, which pnpm --filter api stripe:catalog creates. Setting any of the four replaces the lookup key catalog with the ids they name
STRIPE_PRICE_INDIE_MONTHLY=
# optional override; empty resolves the price by its lookup key
STRIPE_PRICE_INDIE_YEARLY=
# optional override; empty resolves the price by its lookup key
STRIPE_PRICE_ULTIMATE_MONTHLY=
# optional override; empty resolves the price by its lookup key
STRIPE_PRICE_ULTIMATE_YEARLY=
CRON_BILLING_RECONCILE=0 7 * * *    # daily reconciliation against Stripe, UTC
CRON_TRIAL_NOTICES=0 9 * * *      # trial milestone emails, UTC
BILLING_ENABLED=false             # true starts every new account on a trial and gates access afterwards
TRIAL_DAYS=7                      # trial length in days when BILLING_ENABLED=true. REFUSES TO BOOT at 0 with billing enabled, which would lock out every new account
TRUST_PROXY=0                     # number of proxies you control between the internet and the API, counting the web app as one; true means 1 and false means 0. Lets auth rate-limits key on the real client IP. WARNS in production when 0
ACCOUNT_DELETION_GRACE_DAYS=7        # days a scheduled workspace deletion stays reversible before the retention job erases it
# optional, hosted only. Sentry dsn for scrubbed error reports. Ignored unless NODE_ENV=production and BILLING_ENABLED=true, so a self hosted deployment never reports errors outside itself
ERROR_TRACKING_DSN=
# optional. SEARCHADS client id from Apple Ads account settings, API. The four credentials are all set or all unset. REFUSES TO BOOT when only some are set
APPLE_ADS_CLIENT_ID=
# SEARCHADS team id
APPLE_ADS_TEAM_ID=
# key id Apple returned when the public key was uploaded
APPLE_ADS_KEY_ID=
# path to the prime256v1 private key PEM, e.g. keys/apple-ads-private.pem. Relative paths resolve against apps/api, which the Compose stacks mount read only at apps/api/keys. REFUSES TO BOOT when the four are set and the path is not a readable file. Its contents are never logged
APPLE_ADS_PRIVATE_KEY_PATH=
# optional; empty uses the first ad account the credentials can read
APPLE_ADS_AD_ACCOUNT_ID=
CRON_APPLE_POPULARITY=0 9 * * 1   # weekly Apple search popularity sync, UTC. Never scheduled while the Apple Ads credentials are unset
# optional. base64 of 32 random bytes (openssl rand -base64 32). Seals the App Store Connect and Play Console keys owners connect in Integrations; empty keeps every store connection off and nothing contacts Apple or Google. REFUSES TO BOOT when set and not 32 bytes. Never logged
STORE_CONNECT_ENCRYPTION_KEY=
# optional. The key being rotated away from; a stored credential sealed with it is opened and resealed with the current key on first use. REFUSES TO BOOT when set without STORE_CONNECT_ENCRYPTION_KEY
STORE_CONNECT_ENCRYPTION_KEY_PREVIOUS=
# optional. Client ID of a Google Cloud OAuth client of type Web application whose authorized redirect URI is WEB_PUBLIC_URL/integrations/google-play. With the secret and WEB_PUBLIC_URL it lets owners connect Google Play by signing in with Google instead of a service account key. The two GOOGLE_PLAY_OAUTH_ variables are both set or both unset. REFUSES TO BOOT when only one is set
GOOGLE_PLAY_OAUTH_CLIENT_ID=
# client secret of that OAuth client. Publish its consent screen to production, or Google expires every sign in after seven days. Never logged
GOOGLE_PLAY_OAUTH_CLIENT_SECRET=
CRON_STORE_REPORTS=30 5 * * *      # daily download of the reports each connected store console published, UTC. Never scheduled while STORE_CONNECT_ENCRYPTION_KEY is empty
LOG_LEVEL=debug
