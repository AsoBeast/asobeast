{
  "moduleFileExtensions": ["js", "json", "ts", "tsx"],
  "rootDir": ".",
  "maxWorkers": 1,
  "workerIdleMemoryLimit": "1GB",
  "testEnvironment": "node",
  "testTimeout": 30000,
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": ["<rootDir>/setup-e2e.ts"],
  "setupFilesAfterEnv": [
    "<rootDir>/helpers/reset-tracked-data.ts",
    "<rootDir>/helpers/reset-test-redis.ts"
  ],
  "transform": {
    "^.+\\.(t|j)sx?$": "ts-jest"
  }
}
