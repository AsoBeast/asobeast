{
  "name": "api",
  "version": "1.1.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "nest build",
    "db:generate": "prisma generate",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "nest start --watch",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "stripe:catalog": "ts-node --project tsconfig.json scripts/create-stripe-catalog.ts",
    "workspace:suspend": "ts-node --project tsconfig.json scripts/suspend-workspace.ts suspend",
    "workspace:restore": "ts-node --project tsconfig.json scripts/suspend-workspace.ts restore",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "pnpm -w run build:packages && jest --config ./test/jest-e2e.json",
    "test:isolation": "pnpm -w run build:packages && jest --config ./test/isolation/jest-isolation.json",
    "test:upgrade": "jest --config ./test/upgrade/jest-upgrade.json",
    "test:shutdown": "bash ./test/shutdown/run-drill.sh",
    "smoke:providers": "ts-node --project tsconfig.json test/providers/smoke-providers.ts",
    "bench": "pnpm -w run build:packages && jest --config ./test/load/jest-load.json",
    "bench:small": "BENCH_SCALE=small pnpm run bench",
    "bench:target": "BENCH_SCALE=target pnpm run bench",
    "bench:stress": "BENCH_SCALE=stress pnpm run bench"
  },
  "dependencies": {
    "@asobeast/mcp-tools": "workspace:*",
    "@asobeast/shared": "workspace:*",
    "@bull-board/api": "^9.5.0",
    "@bull-board/express": "^9.5.0",
    "@bull-board/nestjs": "^9.5.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@mradex77/google-play-scraper": "^1.1.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@perttu/app-store-scraper": "^2.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nestjs": "^10.71.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.1",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "nestjs-pino": "4.6.1",
    "nodemailer": "^9.0.5",
    "openai": "^7.7.0",
    "pg": "^8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "22.5.0",
    "undici": "8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@asobeast/typescript-config": "workspace:*",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/client": "2.0.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!**/*.module.ts",
      "!main.ts",
      "!**/dto/**",
      "!**/*.types.ts",
      "!**/decorators/**"
    ],
    "coverageReporters": [
      "text-summary",
      "json-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 68,
        "statements": 68,
        "functions": 64,
        "branches": 51
      },
      "./src/auth/entitlement.ts": {
        "lines": 100,
        "branches": 100
      },
      "./src/scoring/formulas.ts": {
        "lines": 98,
        "branches": 95
      },
      "./src/actions/rules/": {
        "lines": 97,
        "branches": 85
      },
      "./src/jobs/retention.service.ts": {
        "lines": 94,
        "branches": 80
      },
      "./src/alerts/alert-flush.service.ts": {
        "lines": 84,
        "branches": 75
      }
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
