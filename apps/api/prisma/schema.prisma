generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Store {
  GOOGLE_PLAY
  APP_STORE
}

enum ProxyProtocol {
  HTTP
  SOCKS5
}

enum ProxyTier {
  DATACENTER
  RESIDENTIAL
}

enum ProxyOutcome {
  SUCCESS
  TRANSPORT
  RATE_LIMITED
  BLOCKED
  SILENT
}

enum KeywordSource {
  TITLE
  SUBTITLE
  DESCRIPTION
  KEYWORD_FIELD
  SUGGESTED
  MANUAL
  COMPETITOR
}

model Workspace {
  id          String       @id @default(cuid())
  name        String       @default("Default")
  apps        App[]
  appGroups   AppGroup[]
  webhooks    Webhook[]
  emailAlerts EmailAlert[]
  alertEvents AlertEvent[]
  users       User[]
  invites     WorkspaceInvite[]
  actions     ActionItem[]
  actionEvents ActionEvent[]
  aiCalls     AiCall[]
  snapshotScreenshots SnapshotScreenshot[]
  keywordFields KeywordField[]
  appLocalizations AppLocalization[]
  appSetups   AppSetup[]
  reviewReplies ReviewReply[]
  chartFollows ChartFollow[]
  storeConnections StoreConnection[]
  storeReportRequests StoreReportRequest[]
  storeReportInstances StoreReportInstance[]
  storeFunnelDays StoreFunnelDay[]
  storeFunnelPageDays StoreFunnelPageDay[]
  storeFunnelSearchTerms StoreFunnelSearchTerm[]
  rankings    KeywordRanking[]
  plan                String    @default("free")
  trialStartedAt      DateTime?
  trialDeclinedAt     DateTime?
  trialEndsAt         DateTime?
  trialNoticeDay      Int?
  dunningNotifiedAt   DateTime?
  downgradeWarnedAt   DateTime?
  planExpiresAt       DateTime?
  billingCustomerId   String?   @unique
  checkoutSessionId   String?
  checkoutClaimedAt   DateTime?
  checkoutClaimToken  String?
  subscriptionId      String?   @unique
  subscriptionStatus  String?
  subscriptionEventAt DateTime?
  cancelAtPeriodEnd   Boolean   @default(false)
  pendingPlan         String?
  overLimitSince      DateTime?
  overLimitNotifiedAt DateTime?
  abuseFlaggedAt      DateTime?
  suspendedAt         DateTime?
  suspendedReason     String?
  deletionRequestedAt DateTime?
  deletionRequestedBy String?
  deletionDueAt       DateTime?
  erasureClaimedAt    DateTime?
  createdAt   DateTime     @default(now())

  @@index([deletionDueAt])
}

model User {
  id                String     @id @default(cuid())
  workspaceId       String
  workspace         Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email             String     @unique
  passwordHash      String
  name              String?
  role              String     @default("owner")
  emailVerifiedAt   DateTime?
  verificationHash  String?    @unique
  verificationExpiresAt DateTime?
  resetHash         String?    @unique
  resetExpiresAt    DateTime?
  sessionVersion    Int        @default(0)
  tokens            ApiToken[]
  sessions          Session[]
  actionEvents      ActionEvent[]
  aiCalls           AiCall[]
  storeConnections  StoreConnection[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([workspaceId])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model BillingEvent {
  id          String    @id
  type        String
  workspaceId String?
  createdAt   DateTime
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  outcome     String?
  failure     String?

  @@index([processedAt])
  @@index([outcome, receivedAt])
}

model TrialClaim {
  key       String   @id
  createdAt DateTime @default(now())
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        String    @default("member")
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  prefix     String
  scope      String    @default("read")
  expiresAt  DateTime?
  lastUsedAt DateTime?
  usageCount Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model AppGroup {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  apps        App[]
  createdAt   DateTime  @default(now())

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model App {
  id           String           @id @default(cuid())
  workspaceId  String
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  store        Store
  storeAppId   String
  country      String           @default("us")
  name         String?
  iconUrl      String?
  delistedAt   DateTime?
  unlistedMarkets String[]       @default([])
  isCompetitor Boolean          @default(false)
  primaryAppId String?
  primaryApp   App?             @relation("AppCompetitors", fields: [primaryAppId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  competitors  App[]            @relation("AppCompetitors")
  groupId      String?
  group        AppGroup?        @relation(fields: [groupId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  snapshots    AppSnapshot[]
  tracked      TrackedKeyword[]
  keywordFields KeywordField[]
  appLocalizations AppLocalization[]
  rankings     KeywordRanking[]
  categoryRanks CategoryRank[]
  changeEvents ChangeEvent[]
  reviews      Review[]
  reviewReplies ReviewReply[]
  replyGuidelines String?
  suggestProbes SuggestProbe[]
  auditInsight AuditInsight?
  appSetup     AppSetup?
  auditScores  AuditScore[]
  actions      ActionItem[]
  actionEvents ActionEvent[]
  storeReportRequests StoreReportRequest[]
  storeFunnelDays StoreFunnelDay[]
  storeFunnelPageDays StoreFunnelPageDay[]
  storeFunnelSearchTerms StoreFunnelSearchTerm[]
  createdAt    DateTime         @default(now())

  @@unique([id, workspaceId])
  @@unique([workspaceId, store, storeAppId, country])
  @@unique([groupId, store])
  @@index([workspaceId])
  @@index([primaryAppId])
  @@index([groupId])
}

model AppSnapshot {
  id             String    @id @default(cuid())
  appId          String
  app            App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  country        String?
  localization   String?
  title          String
  subtitle       String?
  summary        String?
  description    String
  ratingAvg      Float?
  ratingCount    Int?
  installs       BigInt?
  price          Float?
  version        String?
  releasedAt     DateTime?
  storeUpdatedAt DateTime?
  raw            Json
  screenshots    SnapshotScreenshot[]
  capturedAt     DateTime  @default(now())

  @@index([appId, country, localization, capturedAt])
}

model SnapshotScreenshot {
  snapshotId  String
  snapshot    AppSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  position    Int
  url         String
  assetKey    String
  status      String      @default("pending")
  caption     String?
  recipe      String?
  readAt      DateTime?

  @@id([snapshotId, position])
  @@index([workspaceId])
}

model ScreenshotText {
  assetKey  String
  recipe    String
  status    String
  caption   String?
  engine    String
  createdAt DateTime @default(now())
  usedAt    DateTime @default(now())

  @@id([assetKey, recipe])
  @@index([usedAt])
}

model Keyword {
  id          String           @id @default(cuid())
  text        String
  store       Store
  country     String           @default("us")
  metrics     KeywordMetric[]
  tracked     TrackedKeyword[]
  rankings    KeywordRanking[]
  serpEntries SerpEntry[]
  actions     ActionItem[]
  createdAt   DateTime         @default(now())

  @@unique([text, store, country])
}

model TrackedKeyword {
  appId     String
  app       App           @relation(fields: [appId], references: [id], onDelete: Cascade)
  keywordId String
  keyword   Keyword       @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  source     KeywordSource
  active     Boolean       @default(true)
  relevance  Int?
  tags       String[]      @default([])
  note       String?
  createdAt  DateTime      @default(now())

  @@id([appId, keywordId])
  @@index([keywordId])
}

model KeywordField {
  appId        String
  workspaceId  String
  app          App       @relation(fields: [appId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  localization String
  phrases      String[]
  updatedAt    DateTime  @updatedAt

  @@id([appId, localization])
  @@index([workspaceId])
}

model AppLocalization {
  appId        String
  workspaceId  String
  app          App       @relation(fields: [appId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  localization String
  origin       String
  createdAt    DateTime  @default(now())

  @@id([appId, localization])
  @@index([workspaceId])
}

model AppSetup {
  appId             String    @id
  workspaceId       String
  app               App       @relation(fields: [appId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  status            String    @default("not_started")
  skipped           String[]  @default([])
  countriesReviewed Boolean   @default(false)
  selectedMarkets   String[]  @default([])
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([appId, workspaceId])
  @@index([workspaceId])
}

model AuditInsight {
  appId         String    @id
  app           App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  model         String
  checks        Json      @default("{}")
  observations  Json?
  inputHash     String?
  promptVersion String?
  runState      String    @default("completed")
  runError      String?
  requestedAt   DateTime?
  generatedAt   DateTime?
  updatedAt     DateTime  @updatedAt
}

model KeywordMetric {
  keywordId      String
  keyword        Keyword   @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  date           DateTime  @db.Date
  traffic        Float?
  difficulty     Float?
  stats          Json?
  scoringSource  String?
  formulaVersion String?
  confidence     String?
  capturedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@id([keywordId, date])
}

model SearchTermPopularity {
  country           String
  term              String
  week              DateTime @db.Date
  genre             String
  rankInGenre       Int?
  popularity        Int
  popularityInGenre Int?
  createdAt         DateTime @default(now())

  @@id([country, term, week, genre])
  @@index([country, week])
}

model KeywordRanking {
  appId       String
  app         App       @relation(fields: [appId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  keywordId   String
  keyword     Keyword   @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  position    Int?
  depth       Int       @default(200)
  createdAt   DateTime  @default(now())

  @@id([appId, keywordId, date])
  @@index([keywordId, date])
  @@index([appId, date])
  @@index([workspaceId, date])
}

model CategoryRank {
  appId      String
  app        App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  collection String
  genre      String
  position   Int?
  depth      Int      @default(200)
  createdAt  DateTime @default(now())

  @@id([appId, date, collection, genre])
  @@index([appId, date])
}

model ChartCapture {
  id         String       @id @default(cuid())
  store      Store
  country    String
  collection String
  genre      String
  device     String
  date       DateTime     @db.Date
  depth      Int
  capturedAt DateTime     @default(now())
  entries    ChartEntry[]

  @@unique([store, country, collection, genre, device, date])
  @@index([date])
}

model ChartEntry {
  captureId  String
  capture    ChartCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)
  position   Int
  storeAppId String
  title      String
  developer  String?
  iconUrl    String?
  genreId    String?
  free       Boolean?

  @@id([captureId, position])
}

model ChartFollow {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  store       Store
  country     String
  collection  String
  genre       String
  device      String
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, store, country, collection, genre, device])
  @@index([workspaceId])
}

model SerpEntry {
  keywordId   String
  keyword     Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  position    Int
  storeAppId  String
  title       String
  developer   String?
  iconUrl     String?
  ratingAvg   Float?
  ratingCount Int?
  createdAt   DateTime @default(now())

  @@id([keywordId, date, position])
  @@index([storeAppId, date])
  @@index([keywordId, date])
}

model ChangeEvent {
  id         String   @id @default(cuid())
  appId      String
  app        App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  country      String?
  localization String?
  field      String
  before     String?
  after      String?
  detail     Json?
  capturedAt DateTime @default(now())

  @@index([appId, country, localization, capturedAt])
}

model Review {
  id                  String       @id @default(cuid())
  appId               String
  app                 App          @relation(fields: [appId], references: [id], onDelete: Cascade)
  reviewId            String
  userName            String?
  score               Int
  title               String?
  text                String
  version             String?
  reviewedAt          DateTime?
  repliedAt           DateTime?
  replyCheckedAt      DateTime?
  replyText           String?
  reply               ReviewReply?
  translationLanguage String?
  sourceLanguage      String?
  translatedTitle     String?
  translatedText      String?
  translatedAt        DateTime?
  createdAt           DateTime     @default(now())

  @@unique([id, appId])
  @@unique([appId, reviewId])
  @@index([appId, reviewedAt])
  @@index([appId, score])
}

model ReviewReply {
  reviewId    String    @id
  review      Review    @relation(fields: [reviewId, appId], references: [id, appId], onDelete: Cascade)
  appId       String
  workspaceId String
  app         App       @relation(fields: [appId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  text        String
  tone        String?
  model       String?
  generatedAt DateTime?
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([reviewId, appId])
  @@index([appId, repliedAt])
  @@index([workspaceId])
}

model Webhook {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url         String
  events      String[]
  secret      String?
  active      Boolean         @default(true)
  deliveries  AlertDelivery[]
  createdAt   DateTime        @default(now())

  @@index([workspaceId])
}

model EmailAlert {
  id                 String          @id @default(cuid())
  workspaceId        String
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email              String
  events             String[]
  active             Boolean         @default(true)
  confirmedAt        DateTime?
  confirmationSentAt DateTime?
  unsubscribedAt     DateTime?
  deliveries         AlertDelivery[]
  createdAt          DateTime        @default(now())

  @@index([workspaceId])
}

model AlertDelivery {
  id           String      @id @default(cuid())
  channel      String
  webhookId    String?
  webhook      Webhook?    @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  emailAlertId String?
  emailAlert   EmailAlert? @relation(fields: [emailAlertId], references: [id], onDelete: Cascade)
  event        String
  status       String
  detail       String?
  attempt      Int
  createdAt    DateTime    @default(now())

  @@index([webhookId, createdAt])
  @@index([emailAlertId, createdAt])
  @@index([createdAt])
}

model AlertEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event       String
  appId       String?
  dedupeKey   String?
  payload     Json
  createdAt   DateTime  @default(now())
  flushedAt   DateTime?
  flushId     String?
  claimedAt   DateTime?

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, flushedAt, claimedAt])
  @@index([workspaceId, flushId])
  @@index([createdAt])
}

model SuggestProbe {
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  term      String
  country   String
  day       DateTime @db.Date
  probe     String
  results   Json
  createdAt DateTime @default(now())

  @@id([appId, term, country, day, probe])
}

model AuditScore {
  appId         String
  app           App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  overall       Float?
  coveredWeight Int
  totalWeight   Int
  factors       Json
  rubricVersion String   @default("v1")
  confidence    Float?
  createdAt     DateTime @default(now())

  @@id([appId, date])
  @@index([appId, date])
}

model ProxyEndpoint {
  id            String        @id @default(cuid())
  provider      String
  externalId    String
  host          String
  port          Int
  protocol      ProxyProtocol @default(HTTP)
  tier          ProxyTier     @default(DATACENTER)
  credentialRef String
  country       String?
  enabled       Boolean       @default(false)
  retiredAt     DateTime?
  health        ProxyHealth[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([provider, externalId])
  @@unique([host, port])
  @@index([enabled, tier])
}

model ProxyHealth {
  endpointId          String
  endpoint            ProxyEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  store               Store
  successes           Int           @default(0)
  failures            Int           @default(0)
  consecutiveFailures Int           @default(0)
  windowStartedAt     DateTime      @default(now())
  cooldownUntil       DateTime?
  pacedUntil          DateTime?
  lastUsedAt          DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastOutcome         ProxyOutcome?
  updatedAt           DateTime      @updatedAt

  @@id([endpointId, store])
  @@index([store, cooldownUntil])
  @@index([store, pacedUntil])
  @@index([store, lastUsedAt])
}

model ProxySpend {
  month     String
  tier      ProxyTier
  requests  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([month, tier])
}

model ActionItem {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appId          String
  app            App       @relation(fields: [appId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  keywordId      String?
  keyword        Keyword?  @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  rule           String
  category       String
  store          Store
  country        String
  fingerprint    String
  status         String    @default("OPEN")
  priority       String
  impact         Int
  formulaVersion String
  evidence       Json
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime
  resolvedAt     DateTime?
  snoozedUntil   DateTime?
  closedAt       DateTime?
  verifiedAt     DateTime?
  reopenCount    Int       @default(0)
  note           String?
  aiExplanation  String?
  aiModel        String?
  aiGeneratedAt  DateTime?
  events         ActionEvent[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([id, workspaceId])
  @@unique([workspaceId, fingerprint])
  @@index([workspaceId, status, priority])
  @@index([appId, status])
  @@index([keywordId])
  @@index([workspaceId, status, lastSeenAt])
}

model ActionEvent {
  id           String     @id @default(cuid())
  workspaceId  String
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actionId     String
  action       ActionItem @relation(fields: [actionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  appId        String
  app          App        @relation(fields: [appId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  type         String
  actor        String
  status       String
  priority     String
  impact       Int
  snoozedUntil DateTime?
  reason       String?
  occurredAt   DateTime   @default(now())

  @@index([actionId, occurredAt])
  @@index([workspaceId, occurredAt])
  @@index([appId, occurredAt])
}

model AiCall {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  appId             String?
  feature           String
  model             String
  status            String
  inputTokens       Int?
  cachedInputTokens Int?
  outputTokens      Int?
  createdAt         DateTime  @default(now())
  settledAt         DateTime?

  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
}

model StoreConnection {
  id                   String               @id @default(cuid())
  workspaceId          String
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  store                Store
  issuerId             String
  keyId                String
  keyFingerprint       String
  credentialCiphertext String
  status               String               @default("active")
  reportAccess         String               @default("unknown")
  createdByUserId      String?
  createdBy            User?                @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime             @default(now())
  verifiedAt           DateTime?
  lastSyncedAt         DateTime?
  lastError            String?
  bucket               String?
  credential           String               @default("key")
  requests             StoreReportRequest[]

  @@unique([workspaceId, store])
}

model StoreReportRequest {
  id                 String                @id @default(cuid())
  workspaceId        String
  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId       String
  connection         StoreConnection       @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  appId              String
  app                App                   @relation(fields: [appId], references: [id], onDelete: Cascade)
  accessType         String
  state              String                @default("requested")
  remoteId           String?
  reportId           String?
  lastProcessingDate DateTime?             @db.Date
  detailedReportId   String?
  detailedLastProcessingDate DateTime?     @db.Date
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  instances          StoreReportInstance[]

  @@unique([appId, accessType])
}

model StoreReportInstance {
  id             String             @id @default(cuid())
  workspaceId    String
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestId      String
  request        StoreReportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  appId          String
  remoteId       String
  granularity    String
  processingDate DateTime           @db.Date
  raw            Bytes
  sizeInBytes    Int
  segments       Int
  fetchedAt      DateTime           @default(now())
  appliedAt      DateTime?

  @@unique([requestId, remoteId])
  @@index([workspaceId, fetchedAt])
}

model StoreFunnelDay {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appId             String
  app               App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  date              DateTime  @db.Date
  territory         String
  country           String?
  sourceType        String
  pageType          String
  impressions       Int       @default(0)
  uniqueImpressions Int       @default(0)
  pageViews         Int       @default(0)
  uniquePageViews   Int       @default(0)
  gets              Int       @default(0)
  uniqueGets        Int       @default(0)
  processingDate    DateTime  @db.Date

  @@unique([appId, date, territory, sourceType, pageType])
  @@index([appId, country, date])
}

model StoreFunnelPageDay {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appId             String
  app               App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  date              DateTime  @db.Date
  territory         String
  country           String?
  pageTitle         String
  impressions       Int       @default(0)
  uniqueImpressions Int       @default(0)
  pageViews         Int       @default(0)
  uniquePageViews   Int       @default(0)
  gets              Int       @default(0)
  uniqueGets        Int       @default(0)
  processingDate    DateTime  @db.Date

  @@unique([appId, date, territory, pageTitle])
  @@index([appId, country, date])
}

model StoreFunnelSearchTerm {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appId        String
  app          App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  month        DateTime  @db.Date
  term         String
  normalized   String
  visitors     Int       @default(0)
  acquisitions Int       @default(0)
  generation   String

  @@unique([appId, month, term])
  @@index([appId, normalized])
}

model SupportAccess {
  id          String   @id @default(cuid())
  actorUserId String
  actorEmail  String
  workspaceId String
  action      String
  outcome     String   @default("attempted")
  detail      String?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([createdAt])
}
